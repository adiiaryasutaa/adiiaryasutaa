# nuxt-auth-utils — sealed cookie key (generate: openssl rand -base64 32)
NUXT_SESSION_PASSWORD=

# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
# Callback URL: https://adiaryasuta.dev/auth/github
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Admin access — the GitHub username that is allowed to log in
NUXT_ADMIN_GITHUB_LOGIN=

# Secret URL slug — admin lives at /{NUXT_ADMIN_SLUG}
# Use something random, e.g.: openssl rand -hex 6
# Both vars must match — NUXT_ADMIN_SLUG is server-only, NUXT_PUBLIC_ADMIN_SLUG is client-visible
NUXT_ADMIN_SLUG=
NUXT_PUBLIC_ADMIN_SLUG=

# GitHub content repo — separate repository that stores data/*.json, content/blog/*, i18n/locales/*
# Fine-grained PAT with Contents: Read & Write on the content repo
NUXT_GITHUB_CONTENT_PAT=
NUXT_GITHUB_CONTENT_REPO_OWNER=
NUXT_GITHUB_CONTENT_REPO_NAME=
NUXT_GITHUB_CONTENT_BRANCH=
